---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import EmissionCard from '../../components/EmissionCard.astro';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const saisons = await getCollection('saisons');
  return saisons.map((s) => ({ params: { slug: s.slug }, props: { saison: s } }));
}

const { saison } = Astro.props;
const allEmissions = await getCollection(
  'emissions',
  (e) => !e.data.draft && e.data.season.slug === saison.slug
);
const emissions = allEmissions.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Base title={`Saison ${saison.data.number} (${saison.data.years})`}>
  <h1>Saison {saison.data.number} ({saison.data.years}){saison.data.ongoing ? ' – Saison en cours' : ''}</h1>
  <p>
    Émission <strong>Tous Azimuts : pour un monde plus accessible</strong><br />
    Diffusée sur Radio Mon Païs (90.1 FM) et Campus FM Toulouse (94 FM)
  </p>

  <hr />

  <h2>Émissions de la saison {saison.data.number}</h2>
  {emissions.length > 0 ? (
    <>
      <p>Cliquez sur une émission pour lire sa présentation complète et l'écouter.</p>
      <div class="emission-list">
        {emissions.map((e) => (
          <EmissionCard slug={e.slug} title={e.data.title} pubDate={e.data.pubDate} excerpt={e.data.excerpt} />
        ))}
      </div>
    </>
  ) : (
    <p>Les émissions de cette saison seront ajoutées prochainement.</p>
  )}

  <hr />

  <p class="cta-center">
    <a class="button button--outline" href={withBase('/')}>← Retour à l'accueil</a>
    <a class="button" href={withBase('/podcast/')}>Abonnez-vous au podcast de Tous Azimuts</a>
  </p>
</Base>
