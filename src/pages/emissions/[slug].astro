---
import Base from '../../layouts/Base.astro';
import ShareLinks from '../../components/ShareLinks.astro';
import SimilarEpisodes from '../../components/SimilarEpisodes.astro';
import Comments from '../../components/Comments.astro';
import ViewCounter from '../../components/ViewCounter.astro';
import { getCollection, getEntry } from 'astro:content';
import { withBase } from '../../lib/url';
import { tagLabel } from '../../lib/tags';
import { formatYears } from '../../lib/dates';
import youtubeVideos from '../../data/youtube-videos.json';

export async function getStaticPaths() {
  const emissions = await getCollection('emissions');
  return emissions.map((e) => ({ params: { slug: e.slug }, props: { emission: e } }));
}

const { emission } = Astro.props;
const saison = await getEntry(emission.data.season);
const { Content } = await emission.render();
const formattedDate = emission.data.pubDate.toLocaleDateString('fr-FR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const showSlug = 'tous-azimuts-pour-un-monde-plus-accessible';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const youtubeId = emission.data.number
  ? (youtubeVideos as Record<string, string>)[String(emission.data.number)]
  : undefined;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'PodcastEpisode',
  name: emission.data.title,
  url: canonicalUrl,
  datePublished: emission.data.pubDate.toISOString(),
  description: emission.data.excerpt,
  ...(emission.data.number ? { episodeNumber: emission.data.number } : {}),
  partOfSeries: {
    '@type': 'PodcastSeries',
    name: 'Tous Azimuts : pour un monde plus accessible',
    url: Astro.site?.href,
  },
};
---

<Base title={emission.data.title} description={emission.data.excerpt}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

  <p><a href={withBase(`/${saison.slug}/`)}>← Saison {saison.data.number} ({formatYears(saison.data.years)})</a></p>

  <div data-pagefind-body>
    <h1>{emission.data.title}</h1>

    {emission.data.tags.length > 0 && (
      <p class="published-in">
        {emission.data.title}, publié le {formattedDate} dans :{' '}
        {emission.data.tags.map((tag: string, i: number) => (
          <>
            <a href={withBase(`/tags/${tag}/`)}>{tagLabel(tag)}</a>
            {i < emission.data.tags.length - 1 ? ', ' : ''}
          </>
        ))}
      </p>
    )}

    {emission.data.diffusion && (
      <p class="emission-meta">{emission.data.diffusion}</p>
    )}

    <div class="emission-body">
      <Content />
    </div>
  </div>

  {emission.data.rssPlayerId ? (
    <iframe
      id="lecteur-rss"
      src={`https://player.rss.com/${showSlug}/${emission.data.rssPlayerId}?theme=color&v=2&share=false&about=false`}
      width="100%"
      height="202"
      title={`Lecteur audio — ${emission.data.title}`}
      frameborder="0"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen
      scrolling="no"
    ></iframe>
    <script is:inline>
      // Le lecteur appartient à rss.com et s'exécute dans une fenêtre intégrée : ni la police, ni
      // la taille, ni le contraste du site ne peuvent l'atteindre. Le seul réglage qu'il accepte
      // est son thème. On l'accorde donc à celui du visiteur, pour éviter un bloc clair au milieu
      // d'une page sombre. Le changement de thème en cours de visite ne le recharge pas : cela
      // couperait l'écoute. Il suivra au chargement de la page suivante.
      (function () {
        var f = document.getElementById('lecteur-rss');
        if (!f) return;
        var t = document.documentElement.dataset.theme;
        var sombre =
          t === 'dark' ||
          (t === 'system' &&
            window.matchMedia &&
            window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (sombre) f.src = f.src.replace('theme=color', 'theme=dark');
      })();
    </script>
  ) : (
    <p class="emission-meta">Émission bientôt disponible à l'écoute.</p>
  )}

  {emission.data.number && youtubeId && (
    <p class="emission-youtube">
      <a
        class="bouton-youtube"
        href={`https://www.youtube.com/watch?v=${youtubeId}`}
        target="_blank"
        rel="noopener"
      >{`Écouter l'émission ${emission.data.number} sur YouTube`}</a>
    </p>
  )}

  <ShareLinks url={canonicalUrl} title={emission.data.title} />

  <ViewCounter />

  <SimilarEpisodes currentSlug={emission.slug} currentTags={emission.data.tags} />

  <Comments pageId={emission.slug} pageUrl={canonicalUrl} pageTitle={emission.data.title} />
</Base>
