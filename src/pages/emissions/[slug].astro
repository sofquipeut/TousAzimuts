---
import Base from '../../layouts/Base.astro';
import ShareLinks from '../../components/ShareLinks.astro';
import SimilarEpisodes from '../../components/SimilarEpisodes.astro';
import Comments from '../../components/Comments.astro';
import { getCollection, getEntry } from 'astro:content';
import { withBase } from '../../lib/url';
import { tagLabel } from '../../lib/tags';

export async function getStaticPaths() {
  const emissions = await getCollection('emissions');
  return emissions.map((e) => ({ params: { slug: e.slug }, props: { emission: e } }));
}

const { emission } = Astro.props;
const saison = await getEntry(emission.data.season);
const { Content } = await emission.render();
const formattedDate = emission.data.pubDate.toLocaleDateString('fr-FR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const showSlug = 'tous-azimuts-pour-un-monde-plus-accessible';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<Base title={emission.data.title} description={emission.data.excerpt}>
  <p><a href={withBase(`/${saison.slug}/`)}>← Saison {saison.data.number} ({saison.data.years})</a></p>

  <div data-pagefind-body>
    <h1>{emission.data.title}</h1>

    {emission.data.tags.length > 0 && (
      <p class="published-in">
        {emission.data.title}, publié le {formattedDate} dans :{' '}
        {emission.data.tags.map((tag: string, i: number) => (
          <>
            <a href={withBase(`/tags/${tag}/`)}>{tagLabel(tag)}</a>
            {i < emission.data.tags.length - 1 ? ', ' : ''}
          </>
        ))}
      </p>
    )}

    {emission.data.diffusion && (
      <p class="emission-meta">{emission.data.diffusion}</p>
    )}

    <div class="emission-body">
      <Content />
    </div>
  </div>

  {emission.data.rssPlayerId ? (
    <iframe
      src={`https://player.rss.com/${showSlug}/${emission.data.rssPlayerId}?theme=color&v=2&share=false&about=false`}
      width="100%"
      height="202"
      title={`Lecteur audio — ${emission.data.title}`}
      frameborder="0"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen
      scrolling="no"
    ></iframe>
  ) : emission.data.audioUrl ? (
    <p class="cta-center"><a class="button" href={emission.data.audioUrl}>Écouter l'émission</a></p>
  ) : (
    <p class="emission-meta">Émission bientôt disponible à l'écoute.</p>
  )}

  <ShareLinks url={canonicalUrl} title={emission.data.title} />

  <SimilarEpisodes currentSlug={emission.slug} currentTags={emission.data.tags} />

  <Comments pageId={emission.slug} pageUrl={canonicalUrl} pageTitle={emission.data.title} />
</Base>
