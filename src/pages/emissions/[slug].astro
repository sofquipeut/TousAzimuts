---
import Base from '../../layouts/Base.astro';
import { getCollection, getEntry } from 'astro:content';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const emissions = await getCollection('emissions');
  return emissions.map((e) => ({ params: { slug: e.slug }, props: { emission: e } }));
}

const { emission } = Astro.props;
const saison = await getEntry(emission.data.season);
const { Content } = await emission.render();
const formattedDate = emission.data.pubDate.toLocaleDateString('fr-FR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const showSlug = 'tous-azimuts-pour-un-monde-plus-accessible';
---

<Base title={emission.data.title} description={emission.data.excerpt}>
  <p><a href={withBase(`/${saison.slug}/`)}>← Saison {saison.data.number} ({saison.data.years})</a></p>
  <h1>{emission.data.title}</h1>
  <p class="emission-meta">
    {emission.data.diffusion ? emission.data.diffusion : `Diffusée le ${formattedDate}`}
  </p>

  <div class="emission-body">
    <Content />
  </div>

  {emission.data.rssPlayerId ? (
    <>
      <iframe
        src={`https://player.rss.com/${showSlug}/${emission.data.rssPlayerId}?theme=color&v=2&share=false&about=false`}
        width="100%"
        height="202"
        title={`Lecteur audio — ${emission.data.title}`}
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
        scrolling="no"
      ></iframe>
      <p class="cta-center">
        <a href={`https://rss.com/podcasts/${showSlug}/${emission.data.rssPlayerId}/`}>Écouter sur RSS.com</a>
      </p>
    </>
  ) : emission.data.audioUrl && (
    <p class="cta-center"><a class="button" href={emission.data.audioUrl}>Écouter l'émission</a></p>
  )}
</Base>
