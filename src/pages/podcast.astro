---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/url';

// Applications d'écoute : chaque logo vient du site de l'éditeur, et sert de lien vers sa page.
const applications = [
  { nom: 'Pocket Casts', url: 'https://pocketcasts.com', logo: 'pocket-casts.png' },
  { nom: 'Podcast Addict', url: 'https://podcastaddict.com', logo: 'podcast-addict.png' },
  { nom: 'Overcast', url: 'https://overcast.fm', logo: 'overcast.png' },
  { nom: 'Podverse', url: 'https://podverse.fm', logo: 'podverse.png' },
  { nom: 'Castbox', url: 'https://castbox.fm', logo: 'castbox.png' },
  { nom: 'Castamatic', url: 'https://castamatic.com', logo: 'castamatic.png' },
  { nom: 'Castro', url: 'https://castro.fm', logo: 'castro.png' },
  { nom: 'Curiocaster', url: 'https://curiocaster.com', logo: 'curiocaster.png' },
  { nom: 'PodLP', url: 'https://podlp.com', logo: 'podlp.png' },
  { nom: 'Podcast Guru', url: 'https://podcastguru.io', logo: 'podcast-guru.jpg' },
];

// Systèmes où Le Localisateur est disponible.
const systemes = [
  { nom: 'Télécharger pour Windows', url: 'https://localisateur.org/windows.html', logo: 'windows.svg' },
  { nom: 'Installer depuis Google Play', url: 'https://play.google.com/store/apps/details?id=org.localisateur.gps', logo: 'google-play.svg' },
  { nom: "Installer depuis l'App Store", url: 'https://apps.apple.com/fr/app/localisateur/id1393680449', logo: 'app-store.svg' },
];
---

<Base title="Écouter le podcast" description="Abonnez-vous au podcast de Tous Azimuts sur votre plateforme préférée.">
  <h1>
    <span class="ligne-titre">Abonnez-vous</span>
    <span class="ligne-titre">au podcast de</span>
    <span class="ligne-titre titre-accent">Tous Azimuts</span>
  </h1>

  <p>
    Tous Azimuts est diffusée sur <a target="_blank" rel="noopener" href="https://www.radiomonpais.fr/archive-shows/338/tous-azimuts">Radio Mon Païs</a>
    (90.1 FM) les 1er et 3e vendredis du mois de 19h à 20h, et rediffusée le lendemain de 18h à 19h.
    L'émission est également diffusée sur <a target="_blank" rel="noopener" href="https://www.campusfm.net/">Campus FM Toulouse</a>
    (94 FM) les 2e et 4e mercredis du mois à 13h.
  </p>
  <p>Vous avez loupé une émission ? Pas de souci ! Tous Azimuts est également disponible en podcast.</p>

  <h2>Notre principe de diffusion</h2>
  <p>
    Tous Azimuts est d'abord une émission de radio, diffusée sur Radio Mon Païs et Campus FM Toulouse.
    Chaque émission paraît en podcast après sa diffusion à l'antenne. Ce décalage est volontaire :
    la primeur de chaque numéro est laissée aux radios associatives qui la diffusent.
  </p>


  <hr />

  <h2>Plateformes principales</h2>
  <ul class="platform-list">
    <li><a class="button" target="_blank" rel="noopener" style="background-color:#9B42D8" href="https://podcasts.apple.com/us/podcast/tous-azimuts-pour-un-monde-plus-accessible/id1896912865">Apple Podcasts</a></li>
    <li><a class="button" target="_blank" rel="noopener" style="background-color:#1DB954" href="https://open.spotify.com/show/033jp4P1Z6UzWDYEkihHYA">Spotify</a></li>
    <li><a class="button" target="_blank" rel="noopener" style="background-color:#00A8E0" href="https://music.amazon.fr/podcasts/186d7689-1562-4f77-91ca-74f9c05d475e">Amazon Music</a></li>
    <li><a class="button" target="_blank" rel="noopener" style="background-color:#A238D8" href="https://deezer.com/show/1003232231">Deezer</a></li>
    <li><a class="button" target="_blank" rel="noopener" style="background-color:#F55B23" href="https://podcastindex.org/podcast/7910641">Podcast Index</a></li>
    <li><a class="button" target="_blank" rel="noopener" style="background-color:#E60000" href="https://www.youtube.com/playlist?list=PLZ0YUybBg0Os">YouTube</a></li>
  </ul>

  <hr />

  <h2>Également dans vos applications préférées</h2>
  <ul class="platform-logos">
    {applications.map((app) => (
      <li>
        <a target="_blank" rel="noopener" href={app.url}>
          <img src={withBase(`/images/plateformes/${app.logo}`)} alt="" width="64" height="64" loading="lazy" />
          <span>{app.nom}</span>
        </a>
      </li>
    ))}
  </ul>

  <hr />

  <h2>Le podcast dans Le Localisateur</h2>
  <p>
    Tous Azimuts figure aussi au catalogue du
    <a target="_blank" rel="noopener" href="https://localisateur.org/"><strong>Localisateur</strong></a>, l'application gratuite
    qui rend le web accessible aux personnes déficientes visuelles : annuaires, commerces, presse,
    ouvrages audio et podcasts réunis dans une interface simplifiée. Merci à Philippe Léon et à la
    Fondation Valentin Haüy, qui soutient le projet.
  </p>
  <ul class="platform-logos">
    {systemes.map((s) => (
      <li>
        <a target="_blank" rel="noopener" href={s.url}>
          <img src={withBase(`/images/plateformes/${s.logo}`)} alt="" width="64" height="64" loading="lazy" />
          <span>{s.nom}</span>
        </a>
      </li>
    ))}
  </ul>

  <hr />

  <p class="cta-center">
    Pour toute autre application non listée, vous pouvez vous abonner en copiant l'URL du flux RSS :<br />
    <code>https://media.rss.com/tous-azimuts-pour-un-monde-plus-accessible/feed.xml</code>
  </p>
</Base>
