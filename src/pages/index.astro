---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/url';
import { tagLabel } from '../lib/tags';
import { formatYears } from '../lib/dates';
import JourneeDuJour from '../components/JourneeDuJour.astro';
import youtubeVideos from '../data/youtube-videos.json';

// Encadré « journée du jour » : passer à true pour l'afficher sur l'accueil.
const AFFICHER_JOURNEE_DU_JOUR = false;

const saisons = (await getCollection('saisons')).sort((a, b) => a.data.number - b.data.number);

const emissions = await getCollection('emissions', (e) => !e.data.draft);
const sujets = [...new Set(emissions.flatMap((e) => e.data.tags))].sort((a, b) =>
  tagLabel(a).localeCompare(tagLabel(b), 'fr')
);

// Bloc « dernière émission publiée » : la plus récente au sens de la date de publication.
// Les brouillons sont écartés en amont, une émission retirée du dépôt n'existe donc pas ici.
const derniere = [...emissions].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())[0];
const derniereDate = derniere?.data.pubDate.toLocaleDateString('fr-FR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

// Vidéo YouTube de la dernière émission, puisée à la même source que les pages d'émission.
const derniereYoutubeId =
  derniere?.data.number != null
    ? (youtubeVideos as Record<string, string>)[String(derniere.data.number)]
    : undefined;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'PodcastSeries',
  name: 'Tous Azimuts : pour un monde plus accessible',
  url: Astro.site?.href,
  description: "Tous Azimuts, l'émission radio qui éclaire le handicap sous tous ses angles.",
  webFeed: 'https://media.rss.com/tous-azimuts-pour-un-monde-plus-accessible/feed.xml',
};
---

<Base title="Tous Azimuts - Une émission de radio et un podcast d'actualités autour du handicap pour un monde plus accessible" fullTitle>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

  <h1 class="accueil-titre">L'émission radio qui éclaire le handicap <span class="ligne-titre">sous tous ses angles</span></h1>

  <hr />

  {derniere && (
    <section class="derniere-emission" aria-labelledby="titre-derniere-emission">
      <h2 id="titre-derniere-emission" class="titre-orange">Dernière émission</h2>
      <article class="emission-card">
        <h3><a href={withBase(`/emissions/${derniere.slug}/`)}>{derniere.data.title}</a></h3>
        <p class="emission-card__date">Publiée le {derniereDate}</p>
        <p>{derniere.data.excerpt}</p>
        <p class="derniere-emission__actions">
          {derniereYoutubeId ? (
            <a
              class="bouton-youtube"
              href={`https://www.youtube.com/watch?v=${derniereYoutubeId}`}
              target="_blank"
              rel="noopener"
            >Écouter sur YouTube</a>
          ) : (
            <a class="button" href={withBase(`/emissions/${derniere.slug}/`)}>Écouter l'émission</a>
          )}
        </p>
      </article>
    </section>
  )}

  <hr />

  <p class="accueil-slogan">
    Donner la parole à tous<br />
    pour tous,<br />
    c'est la mission de<br />
    <strong>Tous Azimuts</strong>
  </p>

  <p class="accueil-diffusion">
    Émission diffusée sur<br />
    <a href="https://www.radiomonpais.fr/archive-shows/338/tous-azimuts">Radio Mon Païs (90.1&nbsp;FM)</a>,<br />
    <a href="https://www.campusfm.net/">Campus FM Toulouse (94&nbsp;FM)</a>,<br />
    et disponible en <a href={withBase('/podcast/')}>podcast</a>.
  </p>

  <p class="accueil-partenaire">
    Réalisée en partenariat avec l'AVH :<br />
    <a href="https://www.avh.asso.fr/" target="_blank" rel="noopener">Association Valentin Haüy</a>
  </p>

  <p>
    Chaque épisode explore le quotidien des personnes en situation de handicap : déficiences
    sensorielles, motrices, psychiques, maladies invisibles. Tous les sujets sont abordés avec un
    regard critique, positif et toujours un brin d'humour, pour comprendre, s'informer et agir.
  </p>

  <p class="accueil-slogan">
    <strong>Tous Azimuts</strong><br />
    donne la parole à celles et ceux<br />
    qui vivent le handicap<br />
    de l'intérieur<br />
    comme de l'extérieur.
  </p>

  <p>
    Témoignages, interviews d'acteurs associatifs, débats avec aidants et professionnels. Une
    émission animée par une équipe mixte, dont plusieurs
    <a href={withBase('/remerciements/')}>membres</a> sont eux-mêmes en situation de handicap.
  </p>

  <hr />

  <p class="cta-center"><strong>Ensemble, collectons et relayons l'info. Contribuons à rendre notre monde plus accessible !</strong></p>

  <p class="cta-center"><a class="button" href={withBase('/podcast/')}>Abonnez-vous au podcast de Tous Azimuts</a></p>

  <hr />

  <h2>Quand nous écouter ?</h2>
  <p>
    Tous Azimuts est diffusée sur <a href="https://www.radiomonpais.fr/archive-shows/338/tous-azimuts">Radio Mon Païs</a>
    (90.1 FM) les 1er et 3e vendredis du mois de 19h à 20h, et rediffusée le lendemain de 18h à 19h.
    L'émission est également diffusée sur <a href="https://www.campusfm.net/">Campus FM Toulouse</a>
    (94 FM) les 2e et 4e mercredis du mois à 13h.
  </p>

  <hr />

  <h2 id="les-saisons">Les saisons</h2>
  <ul class="season-grid">
    {saisons.map((s) => (
      <li><a class="button button--outline" href={withBase(`/${s.slug}/`)}>Saison {s.data.number} ({formatYears(s.data.years)})</a></li>
    ))}
  </ul>

  <hr />

  <section class="bloc-carnet" aria-labelledby="carnet">
    <h2 id="carnet">Carnet d'adresses</h2>
    <p>
      Les associations, entreprises, lieux et institutions cités dans l'émission, avec leur site, leurs
      coordonnées et les émissions où nous en avons parlé.
    </p>
    <p class="cta-center"><a class="button" href={withBase('/carnet-adresses/')}>Consulter le carnet d'adresses</a></p>
  </section>

  <hr />

  <section class="bloc-pauses" aria-labelledby="pauses-musicales">
    <h2 id="pauses-musicales">Pauses musicales</h2>
    <p>
      Tous les morceaux diffusés dans l'émission, avec un lien pour les écouter et une playlist YouTube
      pour les retrouver à la suite.
    </p>
    <p class="cta-center"><a class="button" href={withBase('/pauses-musicales/')}>Découvrir les pauses musicales</a></p>
  </section>

  <hr />

  <h2 id="les-sujets">Sujets abordés</h2>
  <ul class="sujets-grid">
    {sujets.map((tag) => (
      <li><a class="button button--outline" href={withBase(`/tags/${tag}/`)}>{tagLabel(tag)}</a></li>
    ))}
  </ul>

  <hr />

  <style>
    .accueil-titre {
      text-align: center;
    }
    .accueil-slogan {
      font-size: 1.65rem;
      font-weight: 700;
      line-height: 1.3;
      text-align: center;
      margin: 1.75rem 0;
    }
    .accueil-slogan strong {
      color: var(--color-link-hover);
    }
    .accueil-diffusion {
      font-size: 1.65rem;
      text-align: center;
      margin: 0 0 1rem;
    }
    .accueil-partenaire {
      font-size: 1.2rem;
      border: 1px solid var(--color-border);
      border-radius: 8px;
      padding: 0.9rem 1.1rem;
      margin: 0;
    }
  </style>
</Base>
