---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL;
---

<Base title="Recherche" description="Rechercher dans les émissions de Tous Azimuts.">
  <h1>Rechercher</h1>
  <p>Cherchez un mot-clé, un sujet ou un nom dans toutes les émissions du site.</p>

  <link href={`${base}pagefind/pagefind-ui.css`} rel="stylesheet" />
  <div id="search">Chargement de la recherche…</div>

  <script is:inline>
    window.addEventListener('error', function (e) {
      var box = document.getElementById('search');
      if (box) {
        box.textContent = 'Erreur script : ' + e.message + ' (' + (e.filename || 'source inconnue') + ':' + e.lineno + ':' + e.colno + ')';
      }
    });
  </script>
  <script is:inline src={`${base}pagefind/pagefind-ui.js`}></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', function () {
      var box = document.getElementById('search');
      if (box.textContent.indexOf('Erreur script') === 0) return;
      try {
        if (typeof PagefindUI === 'undefined') {
          throw new Error('PagefindUI est introuvable (le script pagefind-ui.js ne s\'est pas exécuté, sans erreur détectée).');
        }
        box.textContent = '';
        new PagefindUI({
          element: '#search',
          showSubResults: true,
          bundlePath: '/TousAzimuts/pagefind/'
        });
      } catch (err) {
        box.textContent = 'Erreur recherche : ' + err.message;
      }
    });
  </script>
</Base>
