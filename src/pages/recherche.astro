---
import Base from '../layouts/Base.astro';
---

<Base title="Recherche" description="Rechercher dans les émissions de Tous Azimuts.">
  <h1>Rechercher</h1>
  <p>Cherchez un mot-clé, un sujet ou un nom dans toutes les émissions du site.</p>

  <form id="search-form" role="search">
    <label for="search-input">Votre recherche</label><br />
    <input type="search" id="search-input" name="q" autocomplete="off" />
    <button type="submit">Rechercher</button>
  </form>

  <p id="search-status" role="status" aria-live="polite"></p>
  <ul id="search-results" class="emission-list"></ul>

  <script is:inline define:vars={{ base: import.meta.env.BASE_URL }}>
    window.addEventListener('DOMContentLoaded', function () {
      var status = document.getElementById('search-status');
      var results = document.getElementById('search-results');
      var form = document.getElementById('search-form');
      var input = document.getElementById('search-input');
      var pagefindBase = base.endsWith('/') ? base : base + '/';
      var pagefindPromise = null;

      function loadPagefind() {
        if (!pagefindPromise) {
          pagefindPromise = import(pagefindBase + 'pagefind/pagefind.js')
            .then(function (pf) {
              return pf.init().then(function () {
                return pf;
              });
            })
            .catch(function (err) {
              status.textContent = 'Erreur de chargement du moteur de recherche : ' + err.message;
              throw err;
            });
        }
        return pagefindPromise;
      }

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var query = input.value.trim();
        results.innerHTML = '';
        if (!query) {
          status.textContent = '';
          return;
        }
        status.textContent = 'Recherche en cours…';
        loadPagefind()
          .then(function (pf) {
            return pf.search(query);
          })
          .then(function (search) {
            if (!search.results.length) {
              status.textContent = 'Aucun résultat pour « ' + query + ' ».';
              return;
            }
            status.textContent = search.results.length + ' résultat(s) pour « ' + query + ' ».';
            return Promise.all(search.results.map(function (r) { return r.data(); })).then(function (dataList) {
              dataList.forEach(function (data) {
                var li = document.createElement('li');
                li.className = 'emission-card';
                var a = document.createElement('a');
                var url = data.url.indexOf(base) === 0 ? data.url : base.slice(0, -1) + data.url;
                a.href = url;
                a.textContent = (data.meta && data.meta.title) ? data.meta.title : data.url;
                var h3 = document.createElement('h3');
                h3.appendChild(a);
                li.appendChild(h3);
                var excerpt = document.createElement('p');
                excerpt.innerHTML = data.excerpt;
                li.appendChild(excerpt);
                results.appendChild(li);
              });
            });
          })
          .catch(function (err) {
            status.textContent = 'Erreur pendant la recherche : ' + err.message;
          });
      });

      loadPagefind();
    });
  </script>
</Base>
