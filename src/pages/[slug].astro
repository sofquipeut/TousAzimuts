---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import EmissionCard from '../components/EmissionCard.astro';
import { withBase } from '../lib/url';
import { formatYears } from '../lib/dates';

export async function getStaticPaths() {
  const saisons = await getCollection('saisons');
  return saisons.map((s) => ({ params: { slug: s.slug }, props: { saison: s } }));
}

const { saison } = Astro.props;
const allEmissions = await getCollection(
  'emissions',
  (e) => !e.data.draft && e.data.season.slug === saison.slug
);
const emissions = allEmissions.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Base title={`Saison ${saison.data.number} (${formatYears(saison.data.years)})`}>
  <h1>Saison {saison.data.number} ({formatYears(saison.data.years)}){saison.data.ongoing ? ' – Saison en cours' : ''}</h1>
  <p>
    Émission <strong>Tous Azimuts : pour un monde plus accessible</strong><br />
    Diffusée sur Radio Mon Païs (90.1 FM) et Campus FM Toulouse (94 FM)
  </p>

  {saison.data.recap && (
    <>
      <hr />
      <p>{saison.data.recap}</p>
    </>
  )}

  <hr />

  <h2>Émissions de la saison {saison.data.number}</h2>
  {emissions.length > 0 ? (
    <>
      <p>Cliquez sur une émission pour lire sa présentation complète et l'écouter.</p>
      {emissions.length > 1 && (
        <p class="tri-emissions">
          <button type="button" id="tri-emissions" class="bouton-tri">Trier du plus ancien au plus récent</button>
          <span class="tri-statut" role="status"></span>
        </p>
      )}
      <div class="emission-list" id="liste-emissions">
        {emissions.map((e) => (
          <EmissionCard slug={e.slug} title={e.data.title} pubDate={e.data.pubDate} excerpt={e.data.excerpt} />
        ))}
      </div>
    </>
  ) : (
    <p>Les émissions de cette saison seront ajoutées prochainement.</p>
  )}

  <hr />

  <script is:inline>
    (function () {
      var bouton = document.getElementById('tri-emissions');
      var liste = document.getElementById('liste-emissions');
      if (!bouton || !liste) return;
      var statut = document.querySelector('.tri-statut');
      var croissant = false;
      bouton.addEventListener('click', function () {
        var cartes = Array.prototype.slice.call(liste.children);
        cartes.reverse().forEach(function (c) { liste.appendChild(c); });
        croissant = !croissant;
        bouton.textContent = croissant
          ? 'Trier du plus récent au plus ancien'
          : 'Trier du plus ancien au plus récent';
        if (statut) {
          statut.textContent = croissant
            ? 'Émissions triées du plus ancien au plus récent.'
            : 'Émissions triées du plus récent au plus ancien.';
        }
      });
    })();
  </script>

  <style>
    .tri-emissions {
      margin: 0 0 1.5rem;
    }
    .tri-emissions .bouton-tri {
      display: inline-block;
      background: var(--color-accent);
      color: #fff;
      border: 0;
      border-radius: 6px;
      padding: 0.55em 1.1em;
      font: inherit;
      font-weight: 700;
      cursor: pointer;
    }
    .tri-emissions .bouton-tri:hover,
    .tri-emissions .bouton-tri:focus-visible {
      background: var(--color-accent-fonce);
      color: #fff;
    }
    .tri-emissions .bouton-tri:focus-visible {
      outline-color: var(--color-text);
    }
    .tri-statut {
      display: block;
      margin-top: 0.5rem;
      font-size: 0.95em;
    }
  </style>
</Base>
