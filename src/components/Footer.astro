---
import { withBase } from '../lib/url';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <p>Suivez-nous sur les réseaux :</p>
  <ul class="social-links" aria-label="Réseaux sociaux">
    <li><a href="https://www.facebook.com/tousazimutsfm">Facebook</a></li>
    <li><a href="https://www.youtube.com/@tousazimutsfm6498">YouTube</a></li>
    <li><a href="https://piaille.fr/@TousAzimutsFM" rel="me">Mastodon</a></li>
  </ul>
  <nav aria-label="Pied de page" class="footer-nav">
    <ul>
      <li><a href={withBase('/')}>Accueil</a></li>
      <li><a href={withBase('/direct/')}>Écouter en direct</a></li>
      <li><a href={withBase('/podcast/')}>Suivre en podcast</a></li>
      <li><a href={withBase('/contact/')}>Contact</a></li>
      <li><a href={withBase('/confidentialite/')}>Confidentialité</a></li>
    </ul>
  </nav>
  <p class="footer-equipe">
    Carinne Péri – animatrice et coordination<br />
    Marco Lazaro – technique et montage<br />
    Julien Camaret – animateur et programmation musicale<br />
    Sofian Babai – webmaster<br />
    Et des chroniqueurs réguliers.
  </p>
  <div class="footer-partenaires-bloc">
    <p class="footer-partenaires-titre">Nos partenaires :</p>
    <ul class="footer-partenaires">
      <li>
        <a href="https://www.radiomonpais.fr/" target="_blank" rel="noopener">
          <img src={withBase('/images/partenaires/radio-mon-pais.svg')} alt="Radio Mon Païs, 90.1 FM"
            width="890" height="935" loading="lazy" />
        </a>
      </li>
      <li>
        <a href="https://www.campusfm.net/" target="_blank" rel="noopener">
          <img src={withBase('/images/partenaires/campus-fm.png')} alt="Campus FM, Radio Campus Toulouse 94 FM"
            width="778" height="281" loading="lazy" />
        </a>
      </li>
      <li>
        <a href="https://www.avh.asso.fr/" target="_blank" rel="noopener">
          <img src={withBase('/images/partenaires/avh-compact.svg')} alt="Association Valentin Haüy"
            width="115" height="54" loading="lazy" />
        </a>
      </li>
    </ul>
  </div>

  <p class="footer-copyright">© {year} Tous Azimuts</p>
</footer>
