---
import { HYVOR_WEBSITE_ID } from '../lib/comments';

interface Props {
  pageId: string;
  pageUrl: string;
  pageTitle: string;
}

const { pageId } = Astro.props;
---

{HYVOR_WEBSITE_ID && (
  <section aria-labelledby="comments-heading" class="comments">
    <h2 id="comments-heading">Commentaires</h2>
    <script async src="https://talk.hyvor.com/embed/embed.js" type="module"></script>
    <hyvor-talk-comments website-id={HYVOR_WEBSITE_ID} page-id={pageId}></hyvor-talk-comments>
  </section>
)}
