---
import { COMMENTS_PROVIDER_ID } from '../lib/comments';

interface Props {
  pageId: string;
  pageUrl: string;
  pageTitle: string;
}

const { pageId, pageUrl, pageTitle } = Astro.props;
---

{COMMENTS_PROVIDER_ID && (
  <section aria-labelledby="comments-heading" class="comments">
    <h2 id="comments-heading">Commentaires</h2>
    {/* TODO: intégration du fournisseur de commentaires choisi */}
  </section>
)}
