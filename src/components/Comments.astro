---
import { COMMENTS_API_BASE } from '../lib/comments';

interface Props {
  pageId: string;
  pageUrl: string;
  pageTitle: string;
}

const { pageId, pageUrl, pageTitle } = Astro.props;
---

{COMMENTS_API_BASE && (
  <section
    role="region"
    aria-labelledby="comments-heading"
    class="comments"
    data-comments-api={COMMENTS_API_BASE}
    data-page-id={pageId}
    data-page-url={pageUrl}
    data-page-title={pageTitle}
  >
    <h2 id="comments-heading">Commentaires</h2>
    <p id="comments-intro">Donnez-nous votre avis sur cette émission ou signalez-nous une erreur ou un lien mort : vos commentaires sont les bienvenus !</p>

    <ul id="comments-list" aria-live="polite">
      <li id="comments-loading">Chargement des commentaires…</li>
    </ul>

    <form id="comments-form" aria-label="Publier un commentaire">
      <p id="comments-status" role="alert" aria-live="assertive" aria-atomic="true" tabindex="-1"></p>

      <p>
        <label for="comment-name">Nom</label><br />
        <input id="comment-name" name="name" type="text" required maxlength="80" autocomplete="name" />
      </p>

      <p>
        <label for="comment-body">Votre commentaire</label><br />
        <textarea id="comment-body" name="body" required maxlength="2000" rows="4" aria-describedby="comment-body-hint"></textarea>
        <span id="comment-body-hint" class="comments-hint">
          Astuce : pour nommer un lien, utilisez la syntaxe [texte du lien](https://exemple.fr). Les adresses commençant par http:// ou https:// sont aussi rendues cliquables automatiquement.
        </span>
      </p>

      <p class="comments-hp" aria-hidden="true">
        <label for="comment-website">Site web (laisser vide)</label>
        <input id="comment-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </p>

      <button type="submit">Envoyer le commentaire</button>
      <p class="comments-note">Les commentaires sont modérés avant publication.</p>
    </form>
  </section>
)}

<style>
  .comments-hp {
    position: absolute;
    left: -9999px;
  }

  .comments-hint {
    display: block;
    font-size: 0.85rem;
    opacity: 0.8;
    margin-top: 0.25rem;
  }

  #comments-status:focus {
    outline: none;
  }
</style>

<script>
  function initComments() {
    const section = document.querySelector<HTMLElement>('.comments');
    if (!section) return;

    const apiBase = section.dataset.commentsApi;
    const pageId = section.dataset.pageId;
    const pageUrl = section.dataset.pageUrl;
    const pageTitle = section.dataset.pageTitle;
    const startedAt = Date.now();

    const list = section.querySelector<HTMLUListElement>('#comments-list')!;
    const loading = section.querySelector<HTMLLIElement>('#comments-loading')!;
    const form = section.querySelector<HTMLFormElement>('#comments-form')!;
    const status = section.querySelector<HTMLParagraphElement>('#comments-status')!;
    const heading = section.querySelector<HTMLHeadingElement>('#comments-heading')!;
    const intro = section.querySelector<HTMLParagraphElement>('#comments-intro')!;

    function announce(message: string) {
      status.textContent = message;
      status.focus();
    }

    // Reconnaît [texte](https://...) et les URLs brutes, sans rendre de HTML
    // arbitraire : on ne construit que des noeuds texte et des liens <a>.
    const LINK_PATTERN = /\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)|(https?:\/\/[^\s<>()"']+)/g;

    function renderCommentBody(container: HTMLElement, text: string) {
      let lastIndex = 0;
      let match: RegExpExecArray | null;
      while ((match = LINK_PATTERN.exec(text))) {
        if (match.index > lastIndex) {
          container.appendChild(document.createTextNode(text.slice(lastIndex, match.index)));
        }
        const label = match[1];
        const url = match[2] || match[3];
        const link = document.createElement('a');
        link.href = url;
        link.textContent = label || url;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        container.appendChild(link);
        lastIndex = match.index + match[0].length;
      }
      if (lastIndex < text.length) {
        container.appendChild(document.createTextNode(text.slice(lastIndex)));
      }
    }

    fetch(`${apiBase}/api/comments?pageId=${encodeURIComponent(pageId || '')}`)
      .then((res) => res.json())
      .then((comments: Array<{ author_name: string; body: string }>) => {
        loading.remove();
        if (!comments || comments.length === 0) {
          const empty = document.createElement('li');
          empty.textContent = 'Aucun commentaire pour le moment. Soyez le premier à réagir !';
          list.appendChild(empty);
          return;
        }
        heading.textContent = `${comments.length} commentaire${comments.length > 1 ? 's' : ''}`;
        intro.hidden = true;
        for (const c of comments) {
          const item = document.createElement('li');
          const author = document.createElement('strong');
          author.textContent = c.author_name;
          const body = document.createElement('p');
          renderCommentBody(body, c.body);
          item.appendChild(author);
          item.appendChild(body);
          list.appendChild(item);
        }
      })
      .catch(() => {
        loading.textContent = 'Impossible de charger les commentaires pour le moment.';
      });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const formData = new FormData(form);
      const website = formData.get('website');
      if (website) return; // piège à bots

      const name = formData.get('name');
      const body = formData.get('body');

      status.textContent = 'Envoi en cours…';

      fetch(`${apiBase}/api/comments`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ pageId, pageUrl, pageTitle, name, body, website, startedAt }),
      })
        .then((res) => {
          if (!res.ok) throw new Error('failed');
          form.reset();
          announce('Merci ! Votre commentaire est en attente de modération.');
        })
        .catch(() => {
          announce("Une erreur est survenue, réessayez plus tard.");
        });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initComments);
  } else {
    initComments();
  }
</script>
