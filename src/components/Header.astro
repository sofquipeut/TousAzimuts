---
import { getCollection } from 'astro:content';
import { withBase } from '../lib/url';

const saisons = await getCollection('saisons');
const current = saisons.find((s) => s.data.ongoing);

// Flèche de retour : présente sur toutes les pages sauf l'accueil.
const estAccueil = /^\/(index\.html)?$/.test(Astro.url.pathname);
---

<div class="theme-bar">
    {!estAccueil && (
      <a id="bouton-retour" class="bouton-retour" href={withBase('/')} aria-label="Page précédente">
        <svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 4 7 12 15 20"></polyline>
        </svg>
      </a>
    )}
  <button type="button" id="affichage-ouvrir" class="theme-toggle" aria-haspopup="dialog">
    Affichage
  </button>
</div>

<dialog id="affichage" class="affichage-panneau" aria-labelledby="affichage-titre">
  <h2 id="affichage-titre" tabindex="-1">Affichage</h2>

  <fieldset>
    <legend>Thème</legend>
    <label><input type="radio" name="theme" value="system" /> Système</label>
    <label><input type="radio" name="theme" value="light" /> Clair</label>
    <label><input type="radio" name="theme" value="dark" /> Sombre</label>
  </fieldset>

  <fieldset>
    <legend>Contraste</legend>
    <label><input type="radio" name="palette" value="standard" /> Standard</label>
    <label><input type="radio" name="palette" value="contraste" /> Contraste maximal</label>
  </fieldset>

  <fieldset>
    <legend>Taille du texte</legend>
    <label><input type="radio" name="taille" value="normale" /> Normale</label>
    <label><input type="radio" name="taille" value="grande" /> Grande</label>
    <label><input type="radio" name="taille" value="tres-grande" /> Très grande</label>
    <label><input type="radio" name="taille" value="maximale" /> Maximale</label>
  </fieldset>

  <fieldset>
    <legend>Police</legend>
    <label><input type="radio" name="police" value="manrope" /> Police du site</label>
    <label><input type="radio" name="police" value="luciole" /> Luciole (basse vision)</label>
    <label><input type="radio" name="police" value="atkinson" /> Atkinson Hyperlegible (basse vision)</label>
    <label><input type="radio" name="police" value="arial" /> Arial</label>
    <label><input type="radio" name="police" value="verdana" /> Verdana</label>
  </fieldset>

  <p id="affichage-statut" role="status"></p>

  <p class="affichage-actions">
    <button type="button" id="affichage-reinit">Réinitialiser</button>
    <button type="button" id="affichage-fermer">Fermer</button>
  </p>
</dialog>

<header class="site-header">
  <div class="site-header__bar">
    <a class="site-title" href={withBase('/')}>
      <img
        class="site-logo"
        src={withBase('/images/logo-header.png')}
        width="40"
        height="56"
        alt="Logo Tous Azimuts : ondes radio bleues, silhouette orange bras ouverts vers tous les horizons."
      />
      <span class="site-title__texte">
        <span class="site-title__nom">Tous Azimuts</span>
        <span class="site-title__accroche">Pour un monde plus&nbsp;accessible</span>
      </span>
    </a>
    <nav aria-label="Navigation principale" class="site-nav">
      <ul>
        <li><a href={withBase('/')}>Accueil</a></li>
        <li><a href={withBase('/direct/')}>Écouter en direct</a></li>
        <li><a href={withBase('/podcast/')}>Suivre en podcast</a></li>
        {current && (
          <li><a href={withBase(`/${current.slug}/`)}>Saison {current.data.number} (en cours)</a></li>
        )}
        <li><a href={withBase('/#les-saisons')}>Toutes les émissions</a></li>
        <li><a href={withBase('/pauses-musicales/')}>Pauses musicales</a></li>
        <li><a href={withBase('/carnet-adresses/')}>Carnet d'adresses</a></li>
        {/* Lien à réactiver une fois le calendrier validé :
        <li><a href={withBase('/calendrier-journees-mondiales/')}>Calendrier des journées mondiales</a></li> */}
        <li><a href={withBase('/contact/')}>Contact</a></li>
      </ul>
    </nav>

    <form class="site-search" role="search" aria-label="Recherche sur le site" method="get" action={withBase('/recherche/')}>
      <label for="site-search-input" class="sr-only">Rechercher sur le site</label>
      <input type="search" id="site-search-input" name="q" placeholder="Rechercher…" autocomplete="off" />
      <button type="submit">Rechercher</button>
    </form>
  </div>
</header>

<script is:inline>
  (function () {
    var CLE = 'taz-prefs-v1';
    var racine = document.documentElement;
    var ouvrir = document.getElementById('affichage-ouvrir');
    var panneau = document.getElementById('affichage');
    var statut = document.getElementById('affichage-statut');
    if (!ouvrir || !panneau) return;

    // Navigateur ancien sans prise en charge de la fenêtre native : on n'affiche rien plutôt
    // qu'un panneau cassé, et le site reste utilisable avec le thème du système.
    if (typeof panneau.showModal !== 'function') {
      ouvrir.hidden = true;
      panneau.hidden = true;
      return;
    }

    function lirePrefs() {
      try {
        var p = JSON.parse(localStorage.getItem(CLE) || '{}');
        if (p.theme !== 'light' && p.theme !== 'dark') p.theme = 'system';
        if (p.palette !== 'contraste') p.palette = 'standard';
        if (['grande', 'tres-grande', 'maximale'].indexOf(p.taille) === -1) p.taille = 'normale';
        if (['luciole', 'atkinson', 'arial', 'verdana'].indexOf(p.police) === -1) p.police = 'manrope';
        return p;
      } catch (e) {
        return { theme: 'system', palette: 'standard', taille: 'normale', police: 'manrope' };
      }
    }

    function ecrirePrefs(p) {
      try { localStorage.setItem(CLE, JSON.stringify(p)); } catch (e) {}
    }

    function appliquer(p) {
      racine.dataset.theme = p.theme;
      racine.dataset.palette = p.palette;
      racine.dataset.taille = p.taille;
      racine.dataset.police = p.police;
    }

    function cocher(p) {
      var champs = ['theme', 'palette', 'taille', 'police'];
      champs.forEach(function (nom) {
        var el = panneau.querySelector('input[name="' + nom + '"][value="' + p[nom] + '"]');
        if (el) el.checked = true;
      });
    }

    function libelle(champ) {
      var l = champ.closest('label');
      return l ? l.textContent.trim() : champ.value;
    }

    var prefs = lirePrefs();
    appliquer(prefs);
    cocher(prefs);

    panneau.addEventListener('change', function (evenement) {
      var champ = evenement.target;
      if (!champ.name) return;
      prefs[champ.name] = champ.value;
      appliquer(prefs);
      ecrirePrefs(prefs);
      if (statut) {
        var noms = { theme: 'Thème', palette: 'Contraste', taille: 'Taille du texte', police: 'Police' };
        statut.textContent = (noms[champ.name] || champ.name) + ' : ' + libelle(champ) + '.';
      }
    });

    var reinit = document.getElementById('affichage-reinit');
    if (reinit) {
      reinit.addEventListener('click', function () {
        prefs = { theme: 'system', palette: 'standard', taille: 'normale', police: 'manrope' };
        appliquer(prefs);
        ecrirePrefs(prefs);
        cocher(prefs);
        if (statut) statut.textContent = 'Réglages remis à zéro.';
      });
    }

    ouvrir.addEventListener('click', function () {
      if (statut) statut.textContent = '';
      panneau.showModal();
      // Le focus va sur le titre du panneau : le lecteur d'écran annonce « Affichage »,
      // puis la tabulation mène au premier groupe de réglages.
      var titre = document.getElementById('affichage-titre');
      if (titre) titre.focus();
    });

    var fermer = document.getElementById('affichage-fermer');
    if (fermer) fermer.addEventListener('click', function () { panneau.close(); });

    // À la fermeture, le focus revient au bouton qui a ouvert le panneau.
    panneau.addEventListener('close', function () { ouvrir.focus(); });
  })();
</script>

<script is:inline>
  (function () {
    var retour = document.getElementById('bouton-retour');
    if (!retour) return;
    // Ramène d'où l'on vient ; sans historique, le lien mène à l'accueil.
    if (window.history.length > 1) {
      retour.addEventListener('click', function (evenement) {
        evenement.preventDefault();
        window.history.back();
      });
    }
  })();
</script>
