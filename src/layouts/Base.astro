---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import VisitTracker from '../components/VisitTracker.astro';
import { withBase } from '../lib/url';
import '../styles/fonts.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  fullTitle?: boolean;
  noindex?: boolean;
}

const {
  title,
  description = "Tous Azimuts, l'émission radio qui éclaire le handicap sous tous ses angles.",
  fullTitle = false,
  noindex = false,
} = Astro.props;

const ogTitle = fullTitle ? title : `Tous Azimuts - ${title}`;
const ogUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(`${import.meta.env.BASE_URL}icon-512.png`, Astro.site).href;

// Bouton « Vers Accueil » du bas de page : masqué sur l'accueil (on y est déjà).
const estAccueil = /^\/(index\.html)?$/.test(Astro.url.pathname);

// Bouton « Abonnez-vous au podcast » du bas de page : masqué sur la page du podcast elle-même,
// où il pointerait vers la page en cours.
const estPagePodcast = /^\/podcast\/(index\.html)?$/.test(Astro.url.pathname);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        try {
          var prefs = JSON.parse(localStorage.getItem('taz-prefs-v1') || '{}');
          var h = document.documentElement;
          h.dataset.theme = (prefs.theme === 'light' || prefs.theme === 'dark') ? prefs.theme : 'system';
          h.dataset.palette = (prefs.palette === 'contraste') ? 'contraste' : 'standard';
          h.dataset.taille = (['grande', 'tres-grande', 'maximale'].indexOf(prefs.taille) !== -1) ? prefs.taille : 'normale';
          h.dataset.police = (['luciole', 'atkinson', 'arial', 'verdana'].indexOf(prefs.police) !== -1) ? prefs.police : 'manrope';
          h.dataset.espacement = (['aere', 'tres-aere'].indexOf(prefs.espacement) !== -1) ? prefs.espacement : 'normal';
        } catch (e) {}
      })();
    </script>
    <link rel="icon" type="image/png" sizes="32x32" href={`${import.meta.env.BASE_URL}favicon-32.png`} />
    <link rel="icon" type="image/png" sizes="512x512" href={`${import.meta.env.BASE_URL}icon-512.png`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="google-site-verification" content="FltP_nPLgvxEwWmAVEjgkbPt9w-3Dx0wEG8ZGpNHf4w" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tous Azimuts" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="fr_FR" />
    <link rel="canonical" href={ogUrl} />
    <title>{fullTitle ? title : `${title} · Tous Azimuts, pour un monde plus accessible`}</title>
    <link
      rel="preload"
      href={`${import.meta.env.BASE_URL}fonts/manrope-latin.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Aller au contenu principal</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <div class="page-nav">
      {!estPagePodcast && (
        <a class="button" href={withBase('/podcast/')}>Abonnez-vous au podcast de Tous Azimuts</a>
      )}
      {!estAccueil && <a href={withBase('/')}>Vers Accueil</a>}
      <a href="#top">Vers le haut</a>
    </div>
    <Footer />
    <VisitTracker />
  </body>
</html>
